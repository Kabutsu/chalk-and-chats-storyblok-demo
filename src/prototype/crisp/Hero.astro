---
// PROTOTYPE — Storyblok block: hero. Split screen: copy block left, tall photo right.
import { Image } from 'astro:assets';
interface Cta { label: string; url: string; note?: string }
interface Props {
	eyebrow: string;
	headline: string;
	subheadline: string;
	primaryCta: Cta;
	secondaryCta: Cta;
	image: ImageMetadata;
	imageAlt: string;
}
const { eyebrow, headline, subheadline, primaryCta, secondaryCta, image, imageAlt } = Astro.props;
---

<section class="hero" aria-labelledby="hero-h">
	<div class="hero__copy on-green">
		<p class="tag">{eyebrow}</p>
		<h1 id="hero-h" class="hero__title">{headline}</h1>
		<p class="hero__sub">{subheadline}</p>
		<div class="hero__ctas">
			<a class="btn btn--lime btn--xl" href={primaryCta.url} rel="noopener">{primaryCta.label}</a>
			<a class="btn btn--ghost btn--xl" href={secondaryCta.url} target="_blank" rel="noopener">
				{secondaryCta.label}<span class="sr"> (opens in a new tab)</span>
			</a>
		</div>
		{secondaryCta.note && <p class="hero__note">{secondaryCta.note}</p>}
	</div>
	<div class="hero__photo">
		<Image src={image} alt={imageAlt} widths={[480, 800, 1100]} sizes="(min-width: 60rem) 50vw, 100vw" loading="eager" fetchpriority="high" />
	</div>
</section>

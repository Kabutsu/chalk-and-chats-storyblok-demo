---
// PROTOTYPE — Storyblok block: team (name, role, favourite spot, fun fact; photo to come).
const { team } = Astro.props;
---
<section class="section-gap" id="team" aria-labelledby="team-h">
	<h2 id="team-h">Meet the team</h2>
	<p>The faces you’ll see at Sessions. Say hello, they don’t bite.</p>
	<ul class="team-grid">
		{team.map((m: any) => (
			<li class="tile">
				<div class="avatar" aria-hidden="true">{m.name[0]}</div>
				<h3>{m.name}</h3>
				<p class="role">{m.role}</p>
				<p><strong>Find me:</strong> {m.spot}</p>
				<p><strong>Fun fact:</strong> {m.fact}</p>
			</li>
		))}
	</ul>
</section>

---
// PROTOTYPE — throwaway. Future Storyblok block: faq (native <details> accordions).
interface Props {
	faq: { question: string; answer: string }[];
}
const { faq } = Astro.props;
---

<div class="faq">
	{
		faq.map((f) => (
			<details>
				<summary>{f.question}</summary>
				<p>{f.answer}</p>
			</details>
		))
	}
</div>

---
// PROTOTYPE — shared Storyblok-shaped block: video_lightbox (poster + play button; video loads only when opened).
// Variants theme it with --vl-accent / --vl-ink / --vl-radius. Fields: poster image, video URL, label, duration.
import { Image } from 'astro:assets';
import { assets } from './assets';
interface Props { label: string; duration: string; class?: string }
const { label, duration, class: cls = '' } = Astro.props;
---
<div class:list={['vl', cls]} data-vl>
	<button type="button" class="vl-open" aria-haspopup="dialog" aria-label={`Play video: ${label} (${duration})`}>
		<Image src={assets.videoPoster} alt="" width={360} height={640} widths={[360, 720]} sizes="(min-width: 960px) 340px, 80vw" loading="eager" />
		<span class="vl-play" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
		<span class="vl-cap" aria-hidden="true">{label} · {duration}</span>
	</button>
	<dialog class="vl-dialog" aria-label={label} data-src={assets.videoUrl} data-poster={assets.videoPoster.src}>
		<button type="button" class="vl-close">Close video</button>
		<div class="vl-stage"></div>
	</dialog>
</div>

<style is:global>
	.vl-open { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; color: inherit; font: inherit; }
	.vl-open img { display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; border-radius: var(--vl-radius, 16px); }
	.vl-play { position: absolute; inset: 0; margin: auto; width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; background: var(--vl-accent, #e8b923); color: var(--vl-ink, #1d241e); box-shadow: 0 6px 20px rgb(0 0 0 / .35); }
	.vl-cap { position: absolute; left: 10px; right: 10px; bottom: 10px; padding: 8px 12px; border-radius: 999px; background: rgb(20 30 20 / .88); color: #fff; font-weight: 700; font-size: .85rem; line-height: 1.25; text-align: center; }
	.vl-open:focus-visible { outline: 3px solid var(--vl-accent, #e8b923); outline-offset: 4px; border-radius: var(--vl-radius, 16px); }
	.vl-dialog { width: min(92vw, 420px); max-height: 94dvh; padding: 12px; border: 0; border-radius: 16px; background: #111; color: #fff; }
	.vl-dialog::backdrop { background: rgb(0 0 0 / .8); }
	.vl-close { display: block; margin: 0 0 10px auto; min-height: 44px; padding: 8px 18px; border: 2px solid #fff; border-radius: 999px; background: transparent; color: #fff; font: 700 .95rem system-ui, sans-serif; cursor: pointer; }
	.vl-close:focus-visible { outline: 3px solid var(--vl-accent, #e8b923); outline-offset: 2px; }
	.vl-stage video { display: block; width: 100%; max-height: calc(94dvh - 90px); aspect-ratio: 9 / 16; object-fit: contain; background: #000; }
</style>
<script>
	document.querySelectorAll<HTMLElement>('[data-vl]').forEach((root) => {
		const open = root.querySelector<HTMLButtonElement>('.vl-open')!;
		const dlg = root.querySelector<HTMLDialogElement>('.vl-dialog')!;
		const stage = root.querySelector<HTMLElement>('.vl-stage')!;
		open.addEventListener('click', () => {
			const v = document.createElement('video');
			v.controls = true; v.playsInline = true; v.preload = 'metadata';
			v.poster = dlg.dataset.poster ?? ''; v.src = dlg.dataset.src ?? '';
			v.setAttribute('aria-label', 'Chalk & Chats welcome video (captions and transcript to be added)');
			stage.replaceChildren(v);
			dlg.showModal();
			v.play().catch(() => {});
		});
		dlg.querySelector('.vl-close')!.addEventListener('click', () => dlg.close());
		dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
		dlg.addEventListener('close', () => { stage.replaceChildren(); open.focus(); });
	});
</script>

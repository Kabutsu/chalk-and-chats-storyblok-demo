---
// PROTOTYPE
import { Image } from 'astro:assets';
import { assets } from '../assets';
import { site } from '../data';
import { href } from './format';
---

<footer class="site-footer">
	<div class="wrap cols">
		<div>
			<Image class="foot-logo" src={assets.logo} alt="" width={144} height={144} />
			<p><strong>{site.name}</strong><br />{site.tagline}</p>
			<a class="btn btn--cream btn--sm" href={site.whatsappUrl} rel="noopener">Join the WhatsApp group</a>
		</div>
		<nav aria-label="Footer">
			<h2>Explore</h2>
			<ul>{site.nav.map((n) => <li><a href={href(n.slug)}>{n.label}</a></li>)}</ul>
		</nav>
		<div>
			<h2>Say hello</h2>
			<ul>
				<li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
				<li><a href={site.instagramUrl} rel="noopener">Instagram {site.instagramHandle}</a></li>
			</ul>
			<p class="small">Prototype — placeholder links and copy.</p>
		</div>
	</div>
</footer>

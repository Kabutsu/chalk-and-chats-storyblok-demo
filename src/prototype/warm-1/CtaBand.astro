---
// PROTOTYPE
import { site, hero } from '../data';
---

<section class="cta-band on-dark" aria-labelledby="cta-h">
	<div class="wrap">
		<h2 id="cta-h">{hero.primaryCta.label}</h2>
		<p>{site.memberCount}+ climbers · {site.tagline}</p>
		<div class="btn-row">
			<a class="btn btn--cream" href={site.whatsappUrl} rel="noopener">{hero.primaryCta.label}</a>
			<a class="btn btn--ghost-light" href={hero.secondaryCta.url} rel="noopener">{hero.secondaryCta.label}</a>
		</div>
	</div>
</section>

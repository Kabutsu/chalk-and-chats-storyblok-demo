---
// PROTOTYPE — inline SVG garment silhouette, tinted via --garment / --ink custom properties
interface Props { kind: 'tee' | 'hoodie' | 'tank'; colour: string; ink: string }
const { kind, colour, ink } = Astro.props;
const paths = {
	tee: 'M70 20 L20 45 L38 88 L60 78 L60 200 H180 V78 L202 88 L220 45 L170 20 Q120 50 70 20 Z',
	hoodie: 'M78 18 Q120 40 162 18 L214 44 L232 130 L202 134 L196 100 V205 H44 V100 L38 134 L8 130 L26 44 Z M92 24 Q120 62 148 24',
	tank: 'M82 16 L96 16 Q120 70 144 16 L158 16 L172 70 Q158 100 172 120 V205 H68 V120 Q82 100 68 70 Z',
};
---

<svg viewBox="0 0 240 220" role="img" aria-hidden="true" focusable="false" class="garment" style={`--garment:${colour};--ink:${ink}`}>
	<path d={paths[kind]} fill="var(--garment)" stroke="#17300f" stroke-width="4" stroke-linejoin="round" fill-rule="evenodd" class="g-fill" />
	<circle cx="120" cy="105" r="14" fill="none" stroke="var(--ink)" stroke-width="5" class="g-ink" />
	<circle cx="120" cy="105" r="4" fill="var(--ink)" class="g-ink-f" />
</svg>

---
// PROTOTYPE
import Layout from '../../../prototype/warm-1/Layout.astro';
import PageBanner from '../../../prototype/warm-1/PageBanner.astro';
import MerchGrid from '../../../prototype/warm-1/MerchGrid.astro';
import { assets } from '../../../prototype/assets';
import { site, parseDropState } from '../../../prototype/data';
const state = parseDropState(Astro.url.searchParams.get('drop'));
---

<Layout title="Merch">
	<PageBanner title={site.nav[2].label} image={assets.chalkBags} alt="Chalk bags laid out on a wooden table outdoors" />
	<MerchGrid state={state} />
</Layout>
